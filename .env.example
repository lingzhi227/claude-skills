# Environment Configuration for agent-research-skills
# Copy this file to your shell profile (~/.zshrc, ~/.bashrc, etc.)
# or use a .env file with your AI agent framework

# Semantic Scholar API Key (optional, for higher rate limits)
# Get one at: https://www.semanticscholar.org/product/api#api-key
# Without key: ~100 requests per 5 minutes
# With key: ~1 request per second sustained
export S2_API_KEY="your-semantic-scholar-api-key-here"

# Output directory for deep research (optional, default: ~/deep-research-output)
# export DEEP_RESEARCH_OUTPUT_DIR="${HOME}/deep-research-output"

# Output directory for GitHub research (optional, default: ./github-research-output)
# export GITHUB_RESEARCH_OUTPUT_DIR="${HOME}/github-research-output"
